<!DOCTYPE html>
<html lang="<%= cv.locale %>" dir="<%= cv.locale === 'ur' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <title><%= cv.title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <% const font = cv.font_family || 'Inter'; %>
  <link href="https://fonts.googleapis.com/css2?family=<%= font.replace(/ /g, '+') %>:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    body { font-family: '<%= font %>', sans-serif; }
    /* Force background colors to print */
    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
  </style>
</head>
<body class="bg-white text-black">
  <% 
    const p = cv.profile || {};
    const we = cv.work_experience || [];
    const ed = cv.education || [];
    const sk = cv.skills || [];
    const fullName = `${p.first_name || ''} ${p.last_name || ''}`.trim();
    const contactInfo = [p.email, p.phone, p.city ? `${p.city}, ${p.country}` : ''].filter(Boolean).join(' | ');
    const template = cv.design_template || 'modern';
  %>

  <% if (template === 'classic') { %>
    <div class="p-12 text-black">
      <div class="border-b-2 border-black pb-6 mb-6 text-center">
        <h1 class="text-4xl font-bold uppercase tracking-wider mb-2"><%= fullName %></h1>
        <p class="text-sm"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-6">
          <h2 class="text-xl font-bold uppercase tracking-widest border-b border-gray-400 pb-1 mb-4">Experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-4">
              <div class="font-bold text-lg"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
              <div class="italic text-sm text-gray-700 mb-2"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
              <% if (exp.activities) { %><p class="text-sm whitespace-pre-wrap leading-relaxed"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-6">
          <h2 class="text-xl font-bold uppercase tracking-widest border-b border-gray-400 pb-1 mb-4">Education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-4">
              <div class="font-bold text-lg"><%= edu.degree %></div>
              <div class="italic text-sm text-gray-700"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-6">
          <h2 class="text-xl font-bold uppercase tracking-widest border-b border-gray-400 pb-1 mb-4">Skills</h2>
          <div class="text-sm space-y-1">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'minimalist') { %>
    <div class="p-14 text-black">
      <div class="mb-12">
        <h1 class="text-3xl font-light tracking-tight mb-2"><%= fullName %></h1>
        <p class="text-sm text-gray-600"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-10 flex">
          <div class="w-1/4 text-sm font-semibold text-gray-500 uppercase tracking-wider pt-1">Experience</div>
          <div class="w-3/4">
            <% we.forEach(exp => { %>
              <div class="mb-8">
                <div class="font-medium text-lg"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
                <div class="text-xs text-gray-500 mb-2 uppercase tracking-wide"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
                <% if (exp.activities) { %><p class="text-sm text-gray-800 leading-relaxed whitespace-pre-wrap"><%= exp.activities %></p><% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-10 flex">
          <div class="w-1/4 text-sm font-semibold text-gray-500 uppercase tracking-wider pt-1">Education</div>
          <div class="w-3/4">
            <% ed.forEach(edu => { %>
              <div class="mb-6">
                <div class="font-medium text-lg"><%= edu.degree %></div>
                <div class="text-xs text-gray-500 uppercase tracking-wide"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-10 flex">
          <div class="w-1/4 text-sm font-semibold text-gray-500 uppercase tracking-wider pt-1">Skills</div>
          <div class="w-3/4 text-sm text-gray-800 space-y-2">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'two-column') { %>
    <div class="flex h-full min-h-[1123px] text-black border-2 border-black">
      <div class="w-1/3 bg-black text-white p-8">
        <h1 class="text-3xl font-bold mb-6"><%= fullName %></h1>
        <div class="mb-8 text-sm text-gray-300 space-y-2">
          <% if (p.email) { %><div><%= p.email %></div><% } %>
          <% if (p.phone) { %><div><%= p.phone %></div><% } %>
          <% if (p.city) { %><div><%= p.city %>, <%= p.country %></div><% } %>
        </div>
        <% if (sk.length > 0) { %>
          <div>
            <h2 class="text-lg font-semibold border-b border-gray-600 pb-2 mb-4 uppercase tracking-wider">Skills</h2>
            <div class="text-sm space-y-3 text-gray-300">
              <% sk.forEach(skill => { %>
                <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
      <div class="w-2/3 p-8 bg-white">
        <% if (we.length > 0) { %>
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-black border-b-2 border-black pb-2 mb-6">Work Experience</h2>
            <% we.forEach(exp => { %>
              <div class="mb-6">
                <div class="font-bold text-xl"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
                <div class="text-sm font-medium text-gray-700 mb-2"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
                <% if (exp.activities) { %><p class="text-sm text-black whitespace-pre-wrap leading-relaxed"><%= exp.activities %></p><% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if (ed.length > 0) { %>
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-black border-b-2 border-black pb-2 mb-6">Education</h2>
            <% ed.forEach(edu => { %>
              <div class="mb-6">
                <div class="font-bold text-xl"><%= edu.degree %></div>
                <div class="text-sm font-medium text-gray-700"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  <% } else if (template === 'creative') { %>
    <div class="p-0 text-black h-full">
      <div class="bg-black p-12 text-white text-center">
        <h1 class="text-5xl font-black tracking-tighter mb-4 shadow-sm"><%= fullName %></h1>
        <p class="text-lg font-medium opacity-90"><%= contactInfo %></p>
      </div>
      <div class="p-12">
        <% if (we.length > 0) { %>
          <div class="mb-10">
            <h2 class="text-2xl font-black text-black mb-6 uppercase tracking-widest border-b-4 border-black pb-2 inline-block">Experience</h2>
            <% we.forEach(exp => { %>
              <div class="mb-6 border-l-4 border-black pl-4 mt-4">
                <div class="font-bold text-xl"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
                <div class="text-sm font-bold text-gray-500 mb-2 uppercase"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
                <% if (exp.activities) { %><p class="text-sm text-gray-800 whitespace-pre-wrap"><%= exp.activities %></p><% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if (ed.length > 0) { %>
          <div class="mb-10">
            <h2 class="text-2xl font-black text-black mb-6 uppercase tracking-widest border-b-4 border-black pb-2 inline-block">Education</h2>
            <% ed.forEach(edu => { %>
              <div class="mb-6 border-l-4 border-black pl-4 mt-4">
                <div class="font-bold text-xl"><%= edu.degree %></div>
                <div class="text-sm font-bold text-gray-500 uppercase"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if (sk.length > 0) { %>
          <div class="mb-10">
            <h2 class="text-2xl font-black text-black mb-6 uppercase tracking-widest border-b-4 border-black pb-2 inline-block">Skills</h2>
            <div class="text-sm font-medium space-y-2 mt-4">
              <% sk.forEach(skill => { %>
                <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% } else if (template === 'professional') { %>
    <div class="p-12 text-black bg-gray-100 h-full min-h-[1123px]">
      <div class="bg-white p-8 border-t-8 border-black shadow-md mb-8 outline outline-1 outline-gray-300">
        <h1 class="text-4xl font-bold mb-2"><%= fullName %></h1>
        <p class="text-gray-700 text-sm"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="bg-white p-8 shadow-md mb-6 border-l-4 border-black outline outline-1 outline-gray-300">
          <h2 class="text-lg font-bold uppercase tracking-wider text-black mb-6 border-b border-gray-300 pb-2">Experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-6 last:mb-0">
              <div class="font-bold text-lg"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
              <div class="text-sm text-gray-600 mb-2 font-medium"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
              <% if (exp.activities) { %><p class="text-sm text-gray-800 whitespace-pre-wrap"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="bg-white p-8 shadow-md mb-6 border-l-4 border-black outline outline-1 outline-gray-300">
          <h2 class="text-lg font-bold uppercase tracking-wider text-black mb-6 border-b border-gray-300 pb-2">Education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-4 last:mb-0">
              <div class="font-bold text-lg"><%= edu.degree %></div>
              <div class="text-sm text-gray-600 font-medium"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="bg-white p-8 shadow-md mb-6 border-l-4 border-black outline outline-1 outline-gray-300">
          <h2 class="text-lg font-bold uppercase tracking-wider text-black mb-6 border-b border-gray-300 pb-2">Skills</h2>
          <div class="text-sm text-gray-800 space-y-2">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'elegant') { %>
    <div class="p-16 text-black text-center">
      <div class="mb-12">
        <h1 class="text-4xl font-normal tracking-widest uppercase mb-4 border-b border-t border-black py-4"><%= fullName %></h1>
        <p class="text-sm italic text-gray-600"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-10 text-left">
          <h2 class="text-xl font-normal uppercase tracking-widest text-center mb-8 text-gray-500">Experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-8">
              <div class="font-semibold text-lg"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
              <div class="text-xs uppercase tracking-wider text-gray-500 mb-3"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
              <% if (exp.activities) { %><p class="text-sm text-black leading-relaxed whitespace-pre-wrap"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-10 text-left">
          <h2 class="text-xl font-normal uppercase tracking-widest text-center mb-8 text-gray-500">Education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-6">
              <div class="font-semibold text-lg"><%= edu.degree %></div>
              <div class="text-xs uppercase tracking-wider text-gray-500"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-10">
          <h2 class="text-xl font-normal uppercase tracking-widest text-center mb-6 text-gray-500">Skills</h2>
          <div class="text-sm text-black space-y-2 inline-block text-left">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'compact') { %>
    <div class="p-8 text-black leading-tight border-4 border-double border-black m-4">
      <div class="text-center mb-4 border-b-2 border-black pb-4">
        <h1 class="text-3xl font-bold mb-1 uppercase tracking-tight"><%= fullName %></h1>
        <p class="text-xs font-bold"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-4">
          <h2 class="text-sm font-bold uppercase bg-black text-white px-2 py-1 mb-2 inline-block">Experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-2 text-xs">
              <span class="font-bold"><%= exp.job_title %></span>, <%= exp.employer %> <span class="text-gray-600 italic ml-2">(<%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %>)</span>
              <% if (exp.activities) { %><p class="mt-1 whitespace-pre-wrap"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-4">
          <h2 class="text-sm font-bold uppercase bg-black text-white px-2 py-1 mb-2 inline-block">Education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-1 text-xs">
              <span class="font-bold"><%= edu.degree %></span>, <%= edu.institution %> <span class="text-gray-600 italic ml-2">(<%= edu.start_date %> - <%= edu.end_date %>)</span>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-4">
          <h2 class="text-sm font-bold uppercase bg-black text-white px-2 py-1 mb-2 inline-block">Skills</h2>
          <div class="text-xs grid grid-cols-2 gap-1">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'europass') { %>
    <div class="p-10 text-black">
      <div class="flex border-b-4 border-black pb-4 mb-6">
        <div class="w-1/3 text-right pr-6 font-bold uppercase text-lg text-black tracking-wider">Personal Information</div>
        <div class="w-2/3 border-l-4 border-black pl-6">
          <h1 class="text-3xl font-bold mb-2 uppercase"><%= fullName %></h1>
          <div class="text-sm space-y-1 font-medium">
            <% if (p.email) { %><div>Email: <%= p.email %></div><% } %>
            <% if (p.phone) { %><div>Phone: <%= p.phone %></div><% } %>
            <% if (p.city) { %><div>Address: <%= p.city %>, <%= p.country %></div><% } %>
          </div>
        </div>
      </div>
      <% if (we.length > 0) { %>
        <div class="flex mb-6">
          <div class="w-1/3 text-right pr-6 font-bold uppercase text-lg text-black tracking-wider">Work Experience</div>
          <div class="w-2/3 border-l-4 border-black pl-6 space-y-4">
            <% we.forEach(exp => { %>
              <div>
                <div class="font-bold border-b border-gray-300 inline-block mb-1"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %></div>
                <div class="font-bold text-lg mt-1"><%= exp.job_title %></div>
                <div class="italic text-gray-600"><%= exp.employer %></div>
                <% if (exp.activities) { %><p class="text-sm mt-1 whitespace-pre-wrap text-black"><%= exp.activities %></p><% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="flex mb-6">
          <div class="w-1/3 text-right pr-6 font-bold uppercase text-lg text-black tracking-wider">Education</div>
          <div class="w-2/3 border-l-4 border-black pl-6 space-y-4">
            <% ed.forEach(edu => { %>
              <div>
                <div class="font-bold border-b border-gray-300 inline-block mb-1"><%= edu.start_date %> - <%= edu.end_date %></div>
                <div class="font-bold text-lg mt-1"><%= edu.degree %></div>
                <div class="italic text-gray-600"><%= edu.institution %></div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="flex mb-6">
          <div class="w-1/3 text-right pr-6 font-bold uppercase text-lg text-black tracking-wider">Skills</div>
          <div class="w-2/3 border-l-4 border-black pl-6 space-y-2 text-sm text-black">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'tech') { %>
    <div class="p-10 bg-black text-white h-full min-h-[1123px] font-mono">
      <div class="border border-white p-8 mb-8 bg-gray-900 shadow-[4px_4px_0_0_#FFF]">
        <h1 class="text-4xl font-bold mb-3"><%= fullName %></h1>
        <p class="text-sm opacity-80">&gt; <%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-xl font-bold mb-4 text-white border-b border-white pb-2 inline-block">~/experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-6 border-l-2 border-dashed border-gray-500 pl-4">
              <div class="font-bold text-lg text-white"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
              <div class="text-sm text-gray-400 mb-2"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
              <% if (exp.activities) { %><p class="text-sm whitespace-pre-wrap text-gray-300"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-xl font-bold mb-4 text-white border-b border-white pb-2 inline-block">~/education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-4 border-l-2 border-dashed border-gray-500 pl-4">
              <div class="font-bold text-lg text-white"><%= edu.degree %></div>
              <div class="text-sm text-gray-400"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-xl font-bold mb-4 text-white border-b border-white pb-2 inline-block">~/skills</h2>
          <div class="text-sm space-y-1 text-gray-300 border-l-2 border-dashed border-gray-500 pl-4">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <!-- Fallback to Modern template logic -->
    <div class="p-10 text-black">
      <div class="border-l-4 border-black pl-6 mb-8">
        <h1 class="text-5xl font-extrabold text-black mb-2"><%= fullName %></h1>
        <p class="text-gray-800 font-medium"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-black mb-4 flex items-center"><span class="w-8 h-px bg-black mr-4"></span>Work Experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-5 pl-12 relative before:absolute before:left-3 before:top-2 before:w-3 before:h-3 before:bg-white before:rounded-full before:border-2 before:border-black">
              <div class="font-bold text-lg"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
              <div class="text-sm text-gray-700 font-medium mb-1"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
              <% if (exp.activities) { %><p class="text-sm text-gray-800 whitespace-pre-wrap"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-black mb-4 flex items-center"><span class="w-8 h-px bg-black mr-4"></span>Education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-4 pl-12 relative before:absolute before:left-3 before:top-2 before:w-3 before:h-3 before:bg-white before:rounded-full before:border-2 before:border-black">
              <div class="font-bold text-lg"><%= edu.degree %></div>
              <div class="text-sm text-gray-700 font-medium"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-black mb-4 flex items-center"><span class="w-8 h-px bg-black mr-4"></span>Skills</h2>
          <div class="pl-12 text-sm space-y-2">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</body>
</html>
