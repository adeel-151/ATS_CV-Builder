<!DOCTYPE html>
<html lang="<%= cv.locale %>" dir="<%= cv.locale === 'ur' ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8">
  <title><%= cv.title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <% const font = cv.font_family || 'Inter'; %>
  <link href="https://fonts.googleapis.com/css2?family=<%= font.replace(/ /g, '+') %>:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <style>
    body { font-family: '<%= font %>', sans-serif; }
    /* Force background colors to print */
    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
  </style>
</head>
<body class="bg-white text-gray-800">
  <% 
    const p = cv.profile || {};
    const we = cv.work_experience || [];
    const ed = cv.education || [];
    const sk = cv.skills || [];
    const fullName = `${p.first_name || ''} ${p.last_name || ''}`.trim();
    const contactInfo = [p.email, p.phone, p.city ? `${p.city}, ${p.country}` : ''].filter(Boolean).join(' | ');
    const template = cv.design_template || 'modern';
  %>

  <% if (template === 'classic') { %>
    <div class="p-12 text-slate-900">
      <div class="border-b-2 border-slate-800 pb-6 mb-6 text-center">
        <h1 class="text-4xl font-bold uppercase tracking-wider mb-2"><%= fullName %></h1>
        <p class="text-sm"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-6">
          <h2 class="text-xl font-bold uppercase tracking-widest border-b border-slate-300 pb-1 mb-4">Experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-4">
              <div class="font-bold text-lg"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
              <div class="italic text-sm text-slate-600 mb-2"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
              <% if (exp.activities) { %><p class="text-sm whitespace-pre-wrap leading-relaxed"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-6">
          <h2 class="text-xl font-bold uppercase tracking-widest border-b border-slate-300 pb-1 mb-4">Education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-4">
              <div class="font-bold text-lg"><%= edu.degree %></div>
              <div class="italic text-sm text-slate-600"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-6">
          <h2 class="text-xl font-bold uppercase tracking-widest border-b border-slate-300 pb-1 mb-4">Skills</h2>
          <div class="text-sm space-y-1">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'minimalist') { %>
    <div class="p-14 text-gray-800">
      <div class="mb-12">
        <h1 class="text-3xl font-light tracking-tight mb-2"><%= fullName %></h1>
        <p class="text-sm text-gray-500"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-10 flex">
          <div class="w-1/4 text-sm font-semibold text-gray-400 uppercase tracking-wider pt-1">Experience</div>
          <div class="w-3/4">
            <% we.forEach(exp => { %>
              <div class="mb-8">
                <div class="font-medium text-lg"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
                <div class="text-xs text-gray-400 mb-2 uppercase tracking-wide"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
                <% if (exp.activities) { %><p class="text-sm text-gray-600 leading-relaxed whitespace-pre-wrap"><%= exp.activities %></p><% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-10 flex">
          <div class="w-1/4 text-sm font-semibold text-gray-400 uppercase tracking-wider pt-1">Education</div>
          <div class="w-3/4">
            <% ed.forEach(edu => { %>
              <div class="mb-6">
                <div class="font-medium text-lg"><%= edu.degree %></div>
                <div class="text-xs text-gray-400 uppercase tracking-wide"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-10 flex">
          <div class="w-1/4 text-sm font-semibold text-gray-400 uppercase tracking-wider pt-1">Skills</div>
          <div class="w-3/4 text-sm text-gray-600 space-y-2">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'two-column') { %>
    <div class="flex h-full min-h-[1123px] text-slate-800">
      <div class="w-1/3 bg-slate-800 text-white p-8">
        <h1 class="text-3xl font-bold mb-6"><%= fullName %></h1>
        <div class="mb-8 text-sm text-slate-300 space-y-2">
          <% if (p.email) { %><div><%= p.email %></div><% } %>
          <% if (p.phone) { %><div><%= p.phone %></div><% } %>
          <% if (p.city) { %><div><%= p.city %>, <%= p.country %></div><% } %>
        </div>
        <% if (sk.length > 0) { %>
          <div>
            <h2 class="text-lg font-semibold border-b border-slate-600 pb-2 mb-4 uppercase tracking-wider">Skills</h2>
            <div class="text-sm space-y-3 text-slate-300">
              <% sk.forEach(skill => { %>
                <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
      <div class="w-2/3 p-8 bg-white">
        <% if (we.length > 0) { %>
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-slate-800 border-b-2 border-slate-200 pb-2 mb-6">Work Experience</h2>
            <% we.forEach(exp => { %>
              <div class="mb-6">
                <div class="font-bold text-xl"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
                <div class="text-sm font-medium text-blue-600 mb-2"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
                <% if (exp.activities) { %><p class="text-sm text-slate-600 whitespace-pre-wrap leading-relaxed"><%= exp.activities %></p><% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if (ed.length > 0) { %>
          <div class="mb-8">
            <h2 class="text-2xl font-bold text-slate-800 border-b-2 border-slate-200 pb-2 mb-6">Education</h2>
            <% ed.forEach(edu => { %>
              <div class="mb-6">
                <div class="font-bold text-xl"><%= edu.degree %></div>
                <div class="text-sm font-medium text-blue-600"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  <% } else if (template === 'creative') { %>
    <div class="p-0 text-slate-800 h-full">
      <div class="bg-gradient-to-r from-amber-400 to-orange-500 p-12 text-white">
        <h1 class="text-5xl font-black tracking-tighter mb-4 shadow-sm"><%= fullName %></h1>
        <p class="text-lg font-medium opacity-90"><%= contactInfo %></p>
      </div>
      <div class="p-12">
        <% if (we.length > 0) { %>
          <div class="mb-10">
            <h2 class="text-2xl font-black text-amber-600 mb-6 uppercase tracking-widest">Experience</h2>
            <% we.forEach(exp => { %>
              <div class="mb-6 border-l-4 border-amber-200 pl-4">
                <div class="font-bold text-xl"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
                <div class="text-sm font-bold text-slate-400 mb-2 uppercase"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
                <% if (exp.activities) { %><p class="text-sm text-slate-600 whitespace-pre-wrap"><%= exp.activities %></p><% } %>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if (ed.length > 0) { %>
          <div class="mb-10">
            <h2 class="text-2xl font-black text-amber-600 mb-6 uppercase tracking-widest">Education</h2>
            <% ed.forEach(edu => { %>
              <div class="mb-6 border-l-4 border-amber-200 pl-4">
                <div class="font-bold text-xl"><%= edu.degree %></div>
                <div class="text-sm font-bold text-slate-400 uppercase"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if (sk.length > 0) { %>
          <div class="mb-10">
            <h2 class="text-2xl font-black text-amber-600 mb-6 uppercase tracking-widest">Skills</h2>
            <div class="text-sm font-medium space-y-2">
              <% sk.forEach(skill => { %>
                <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% } else if (template === 'professional') { %>
    <div class="p-12 text-gray-900 bg-gray-50 h-full min-h-[1123px]">
      <div class="bg-white p-8 border-t-8 border-gray-800 shadow-sm mb-8">
        <h1 class="text-4xl font-bold mb-2"><%= fullName %></h1>
        <p class="text-gray-600 text-sm"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="bg-white p-8 shadow-sm mb-6 border-l-4 border-gray-300">
          <h2 class="text-lg font-bold uppercase tracking-wider text-gray-800 mb-6 border-b border-gray-200 pb-2">Experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-6 last:mb-0">
              <div class="font-bold text-lg"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
              <div class="text-sm text-gray-500 mb-2 font-medium"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
              <% if (exp.activities) { %><p class="text-sm text-gray-600 whitespace-pre-wrap"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="bg-white p-8 shadow-sm mb-6 border-l-4 border-gray-300">
          <h2 class="text-lg font-bold uppercase tracking-wider text-gray-800 mb-6 border-b border-gray-200 pb-2">Education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-4 last:mb-0">
              <div class="font-bold text-lg"><%= edu.degree %></div>
              <div class="text-sm text-gray-500 font-medium"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="bg-white p-8 shadow-sm mb-6 border-l-4 border-gray-300">
          <h2 class="text-lg font-bold uppercase tracking-wider text-gray-800 mb-6 border-b border-gray-200 pb-2">Skills</h2>
          <div class="text-sm text-gray-700 space-y-2">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'elegant') { %>
    <div class="p-16 text-stone-800 text-center">
      <div class="mb-12">
        <h1 class="text-4xl font-normal tracking-widest uppercase mb-4 border-b border-t border-stone-300 py-4"><%= fullName %></h1>
        <p class="text-sm italic text-stone-500"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-10 text-left">
          <h2 class="text-xl font-normal uppercase tracking-widest text-center mb-8 text-stone-400">Experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-8">
              <div class="font-semibold text-lg"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
              <div class="text-xs uppercase tracking-wider text-stone-400 mb-3"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
              <% if (exp.activities) { %><p class="text-sm text-stone-600 leading-relaxed whitespace-pre-wrap"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-10 text-left">
          <h2 class="text-xl font-normal uppercase tracking-widest text-center mb-8 text-stone-400">Education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-6">
              <div class="font-semibold text-lg"><%= edu.degree %></div>
              <div class="text-xs uppercase tracking-wider text-stone-400"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-10">
          <h2 class="text-xl font-normal uppercase tracking-widest text-center mb-6 text-stone-400">Skills</h2>
          <div class="text-sm text-stone-600 space-y-2 inline-block text-left">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'compact') { %>
    <div class="p-8 text-slate-900 leading-tight">
      <div class="text-center mb-4">
        <h1 class="text-2xl font-bold mb-1"><%= fullName %></h1>
        <p class="text-xs"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-4">
          <h2 class="text-sm font-bold uppercase bg-slate-200 px-2 py-1 mb-2">Experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-2 text-xs">
              <span class="font-bold"><%= exp.job_title %></span>, <%= exp.employer %> <span class="text-slate-500 italic ml-2">(<%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %>)</span>
              <% if (exp.activities) { %><p class="mt-1 whitespace-pre-wrap"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-4">
          <h2 class="text-sm font-bold uppercase bg-slate-200 px-2 py-1 mb-2">Education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-1 text-xs">
              <span class="font-bold"><%= edu.degree %></span>, <%= edu.institution %> <span class="text-slate-500 italic ml-2">(<%= edu.start_date %> - <%= edu.end_date %>)</span>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-4">
          <h2 class="text-sm font-bold uppercase bg-slate-200 px-2 py-1 mb-2">Skills</h2>
          <div class="text-xs grid grid-cols-2 gap-1">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'europass') { %>
    <div class="p-10 text-blue-900">
      <div class="flex border-b-2 border-blue-900 pb-4 mb-6">
        <div class="w-1/3 text-right pr-6 font-bold uppercase text-lg text-blue-600">Personal Information</div>
        <div class="w-2/3 border-l-2 border-blue-900 pl-6">
          <h1 class="text-2xl font-bold mb-2"><%= fullName %></h1>
          <div class="text-sm space-y-1">
            <% if (p.email) { %><div>Email: <%= p.email %></div><% } %>
            <% if (p.phone) { %><div>Phone: <%= p.phone %></div><% } %>
            <% if (p.city) { %><div>Address: <%= p.city %>, <%= p.country %></div><% } %>
          </div>
        </div>
      </div>
      <% if (we.length > 0) { %>
        <div class="flex mb-6">
          <div class="w-1/3 text-right pr-6 font-bold uppercase text-lg text-blue-600">Work Experience</div>
          <div class="w-2/3 border-l-2 border-blue-900 pl-6 space-y-4">
            <% we.forEach(exp => { %>
              <div>
                <div class="font-bold"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %></div>
                <div class="font-bold mt-1"><%= exp.job_title %></div>
                <div class="italic"><%= exp.employer %></div>
                <% if (exp.activities) { %><p class="text-sm mt-1 whitespace-pre-wrap text-slate-700"><%= exp.activities %></p><% } %>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="flex mb-6">
          <div class="w-1/3 text-right pr-6 font-bold uppercase text-lg text-blue-600">Education</div>
          <div class="w-2/3 border-l-2 border-blue-900 pl-6 space-y-4">
            <% ed.forEach(edu => { %>
              <div>
                <div class="font-bold"><%= edu.start_date %> - <%= edu.end_date %></div>
                <div class="font-bold mt-1"><%= edu.degree %></div>
                <div class="italic"><%= edu.institution %></div>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="flex mb-6">
          <div class="w-1/3 text-right pr-6 font-bold uppercase text-lg text-blue-600">Skills</div>
          <div class="w-2/3 border-l-2 border-blue-900 pl-6 space-y-2 text-sm text-slate-800">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else if (template === 'tech') { %>
    <div class="p-10 bg-slate-900 text-green-400 h-full min-h-[1123px]">
      <div class="border border-green-500/30 p-8 mb-8 bg-slate-800/50">
        <h1 class="text-4xl font-bold mb-3 text-green-300"><%= fullName %></h1>
        <p class="text-sm opacity-80">&gt; <%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-xl font-bold mb-4 text-green-300 border-b border-green-500/30 pb-2">~/experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-6">
              <div class="font-bold text-lg text-green-200"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
              <div class="text-sm text-green-500/80 mb-2"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
              <% if (exp.activities) { %><p class="text-sm whitespace-pre-wrap text-slate-300"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-xl font-bold mb-4 text-green-300 border-b border-green-500/30 pb-2">~/education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-4">
              <div class="font-bold text-lg text-green-200"><%= edu.degree %></div>
              <div class="text-sm text-green-500/80"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-xl font-bold mb-4 text-green-300 border-b border-green-500/30 pb-2">~/skills</h2>
          <div class="text-sm space-y-1 text-slate-300">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <!-- Fallback to Modern template logic -->
    <div class="p-10 text-slate-800">
      <div class="border-l-4 border-blue-600 pl-6 mb-8">
        <h1 class="text-5xl font-extrabold text-blue-900 mb-2"><%= fullName %></h1>
        <p class="text-blue-700 font-medium"><%= contactInfo %></p>
      </div>
      <% if (we.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-blue-900 mb-4 flex items-center"><span class="w-8 h-px bg-blue-300 mr-4"></span>Work Experience</h2>
          <% we.forEach(exp => { %>
            <div class="mb-5 pl-12 relative before:absolute before:left-3 before:top-2 before:w-3 before:h-3 before:bg-blue-200 before:rounded-full before:border-2 before:border-blue-600">
              <div class="font-bold text-lg"><%= exp.job_title %> <% if (exp.employer) { %><span class="font-normal opacity-80">at <%= exp.employer %></span><% } %></div>
              <div class="text-sm text-blue-600 font-medium mb-1"><%= exp.start_date %> - <%= exp.currently_working ? 'Present' : exp.end_date %> <% if (exp.city) { %>| <%= exp.city %><% } %></div>
              <% if (exp.activities) { %><p class="text-sm text-slate-600 whitespace-pre-wrap"><%= exp.activities %></p><% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (ed.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-blue-900 mb-4 flex items-center"><span class="w-8 h-px bg-blue-300 mr-4"></span>Education</h2>
          <% ed.forEach(edu => { %>
            <div class="mb-4 pl-12 relative before:absolute before:left-3 before:top-2 before:w-3 before:h-3 before:bg-blue-200 before:rounded-full before:border-2 before:border-blue-600">
              <div class="font-bold text-lg"><%= edu.degree %></div>
              <div class="text-sm text-blue-600 font-medium"><%= edu.institution %> | <%= edu.start_date %> - <%= edu.end_date %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
      <% if (sk.length > 0) { %>
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-blue-900 mb-4 flex items-center"><span class="w-8 h-px bg-blue-300 mr-4"></span>Skills</h2>
          <div class="pl-12 text-sm space-y-2">
            <% sk.forEach(skill => { %>
              <div><strong><%= skill.category %>:</strong> <%= skill.description %> (<%= skill.proficiency %>)</div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</body>
</html>
